# syntax=docker/dockerfile:1
# Separate opt-in data-plane images. No frontend, Docker CLI or executor binary.
ARG GO_IMAGE=golang:1.26-bookworm@sha256:a688600ca24f8a4d3ca77f95b0dd40704a9fc787c826660eb7ba0b641b8b175d
ARG RUNTIME_IMAGE=alpine:3.21.3@sha256:a8560b36e8b8210634f77d9f7f9efd7ffa463e380b75e2e74aff4511df3ef88c

FROM ${GO_IMAGE} AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY cmd/ ./cmd/
COPY internal/ ./internal/
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /out/ctfm-proxy ./cmd/ctfm-proxy && \
    CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /out/ctfm-traffic ./cmd/ctfm-traffic

FROM ${RUNTIME_IMAGE} AS proxy
RUN addgroup -g 10002 -S ctfm-proxy && adduser -u 10002 -S -D -H -G ctfm-proxy ctfm-proxy
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=build /out/ctfm-proxy /usr/local/bin/ctfm-proxy
USER 10002:10002
ENTRYPOINT ["/usr/local/bin/ctfm-proxy"]

FROM ${RUNTIME_IMAGE} AS recorder
RUN addgroup -g 10003 -S ctfm-traffic && adduser -u 10003 -S -D -H -G ctfm-traffic ctfm-traffic
COPY --from=build /out/ctfm-traffic /usr/local/bin/ctfm-traffic
USER 10003:10003
ENTRYPOINT ["/usr/local/bin/ctfm-traffic"]
