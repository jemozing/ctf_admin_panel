# syntax=docker/dockerfile:1
# Separate opt-in Linux capture and capability-free packet archive images.
ARG GO_IMAGE=golang:1.26-bookworm@sha256:a688600ca24f8a4d3ca77f95b0dd40704a9fc787c826660eb7ba0b641b8b175d
ARG RUNTIME_IMAGE=alpine:3.21.3@sha256:a8560b36e8b8210634f77d9f7f9efd7ffa463e380b75e2e74aff4511df3ef88c

FROM ${GO_IMAGE} AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY cmd/ ./cmd/
COPY internal/ ./internal/
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /out/ctfm-capture ./cmd/ctfm-capture && \
    CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /out/ctfm-packets ./cmd/ctfm-packets

FROM ${RUNTIME_IMAGE} AS capture
COPY --from=build /out/ctfm-capture /usr/local/bin/ctfm-capture
# Linux raw sockets require CAP_NET_RAW; Compose grants only that capability.
USER 0:0
ENTRYPOINT ["/usr/local/bin/ctfm-capture"]

FROM ${RUNTIME_IMAGE} AS packets
RUN addgroup -g 10005 -S ctfm-packets && adduser -u 10005 -S -D -H -G ctfm-packets ctfm-packets
COPY --from=build /out/ctfm-packets /usr/local/bin/ctfm-packets
USER 10005:10005
ENTRYPOINT ["/usr/local/bin/ctfm-packets"]
